{% extends 'page.html.jinja' %}
{% block body %}
<h1>{{ title }}</h1>
{% if show_edit_controls and create_url %}<a class="button" href="{{ create_url }}">New page</a>{% endif %}
<div class="cards">
  {% for entry in entries %}
    {% include 'card.html.jinja' %}
  {% else %}
    <p>No published content yet.</p>
  {% endfor %}
</div>
{% endblock %}
