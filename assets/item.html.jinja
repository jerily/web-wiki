{% extends 'page.html.jinja' %}
{% block body %}
<div class="actions">
  <a href="{{ parent }}">← Browse</a>
  {% if edit_url %}<a class="button" href="{{ edit_url }}">Edit</a>{% endif %}
</div>
{% if date %}<p class="eyebrow">{{ date }}</p>{% endif %}
{# Only safe-mode cmark output is marked safe; metadata keeps automatic escaping. #}
<article aria-label="{{ title }}">{{ markdown_html|safe }}</article>
<details>
  <summary>Revision history</summary>
  <ol>{% for revision in revisions %}<li>Revision {{ revision.number }} · {{ revision.created_at }}</li>{% endfor %}</ol>
</details>
{% endblock %}
